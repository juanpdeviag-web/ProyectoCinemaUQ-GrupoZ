<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.TicketController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Tu ticket CinemaUQ" subtitulo="Los datos de tu reserva, en un solo lugar." activa="mis_tickets"/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<VBox spacing="14" styleClass="card, receipt-card" maxWidth="720">
 <Label text="CINEMAUQ · COMPROBANTE" styleClass="form-label"/>
 <Label fx:id="peliculaLabel" text="No hay reservas para mostrar" styleClass="section-title" wrapText="true"/>
 <Separator/>
 <Label fx:id="fechaLabel" text="Fecha pendiente"/><Label fx:id="horaLabel" text="Hora pendiente"/>
 <Label fx:id="salaLabel" text="Sala pendiente"/>
 <Label text="Asientos" styleClass="form-label"/>
 <Label fx:id="asientosLabel" text="Sin asientos" wrapText="true" styleClass="stat-value"/>
 <Label text="Productos y combos" styleClass="form-label"/>
 <Label text="El desglose de confitería no está registrado en este comprobante." wrapText="true" styleClass="helper-text"/>
 <Separator/>
 <Label fx:id="usuarioLabel" text="Cliente pendiente" wrapText="true"/>
 <Label fx:id="totalLabel" text="Total pendiente" styleClass="checkout-total" wrapText="true"/>
 <Label fx:id="fechaCompraLabel" text="Fecha de compra pendiente" wrapText="true" styleClass="helper-text"/>
 <Label text="Presenta este comprobante al ingresar a la sala." wrapText="true" styleClass="mensaje-info"/>
</VBox>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver a cartelera" onAction="#onVolver" styleClass="boton-principal"/>
 </FlowPane></bottom>
</BorderPane>
