<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.CarteleraController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page, cartelera-page">
 <top><EncabezadoCinema titulo="CinemaUQ" subtitulo="Tu próxima historia comienza aquí." activa="cartelera"/></top>
 <center><ScrollPane fx:id="carteleraScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
  <VBox styleClass="content-container" alignment="TOP_CENTER">
   <VBox styleClass="app-container, movies-container" maxWidth="1300" spacing="24">
    <VBox styleClass="card, filters-container" spacing="18">
     <Label text="Encuentra tu película" styleClass="section-title"/>
     <GridPane fx:id="filtrosGrid" hgap="20" vgap="16">
      <VBox fx:id="busquedaFiltro" spacing="8" GridPane.columnIndex="0" minWidth="0">
       <Label text="Buscar por título o género" labelFor="$searchField" styleClass="form-label"/>
       <TextField fx:id="searchField" promptText="Escribe un título o género" styleClass="form-field"/>
      </VBox>
      <VBox fx:id="generoFiltro" spacing="8" GridPane.columnIndex="1" minWidth="0">
       <Label text="Género" labelFor="$filtroGenero" styleClass="form-label"/>
       <ComboBox fx:id="filtroGenero" promptText="Todos los géneros" maxWidth="Infinity" styleClass="form-field"/>
      </VBox>
      <VBox fx:id="ordenFiltro" spacing="8" GridPane.columnIndex="2" minWidth="0">
       <Label text="Ordenar por" labelFor="$ordenarPor" styleClass="form-label"/>
       <ComboBox fx:id="ordenarPor" promptText="Relevancia" maxWidth="Infinity" styleClass="form-field"/>
      </VBox>
     </GridPane>
    </VBox>
    <FlowPane hgap="14" vgap="8" alignment="CENTER_LEFT">
     <Label text="Películas en cartelera" styleClass="section-title"/>
     <Label fx:id="contadorPeliculas" text="(0 películas)" styleClass="counter-label"/>
    </FlowPane>
    <Label fx:id="sinPeliculasLabel" text="No encontramos películas con estos filtros. Prueba otro título o género."
           styleClass="empty-state" wrapText="true" visible="false" managed="false"/>
    <TilePane fx:id="peliculasTilePane" prefColumns="4" hgap="24" vgap="24" tileAlignment="TOP_LEFT" alignment="TOP_CENTER" styleClass="movie-grid"/>
   </VBox>
  </VBox>
 </ScrollPane></center>
 <bottom><StackPane styleClass="app-footer">
  <FlowPane styleClass="app-container" maxWidth="1300" hgap="20" vgap="10" alignment="CENTER_LEFT">
   <Label text="CinemaUQ · Vive el cine" styleClass="helper-text"/>
   <Button text="Salir de la aplicación" onAction="#onSalir" styleClass="boton-texto"/>
  </FlowPane>
 </StackPane></bottom>
</BorderPane>
