<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.ConfiteriaController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Algo para acompañar tu película" subtitulo="Elige productos o combos. También puedes continuar con tu selección actual." activa=""/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<Label text="Productos" styleClass="section-title"/>
<TilePane fx:id="productosTilePane" prefColumns="4" hgap="16" vgap="16" alignment="TOP_CENTER" styleClass="catalog-grid"/>
<Label text="Combos" styleClass="section-title"/>
<TilePane fx:id="combosTilePane" prefColumns="3" hgap="16" vgap="16" alignment="TOP_CENTER" styleClass="catalog-grid"/>
<VBox spacing="10" styleClass="card" maxWidth="1100">
 <Label text="Tu selección de confitería" styleClass="section-title"/>
 <Label fx:id="productosSeleccionadosLabel" text="Ningún producto seleccionado" wrapText="true"/>
 <Label fx:id="combosSeleccionadosLabel" text="Ningún combo seleccionado" wrapText="true"/>
 <Label fx:id="totalLabel" text="Subtotal: COP 0" styleClass="stat-value"/>
</VBox>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver a asientos" onAction="#onVolver" styleClass="boton-secundario"/>
<Button fx:id="btnSaltar" text="Continuar sin confitería" onAction="#onSaltar" styleClass="boton-secundario"/>
<Button fx:id="btnContinuar" text="Continuar" onAction="#onContinuar" styleClass="boton-principal"/>
 </FlowPane></bottom>
</BorderPane>
