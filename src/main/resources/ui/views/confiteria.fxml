<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uq.cinemauq.ui.controllers.ConfiteriaController"
            stylesheets="@../styles/estilos.css"
            styleClass="root">

    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            <Label text="🍿 Confitería" styleClass="title">
                <font>
                    <Font name="Segoe UI Bold" size="36"/>
                </font>
            </Label>
            <Label text="Selecciona tus productos y combos" styleClass="subtitle">
                <font>
                    <Font name="Segoe UI" size="18"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox spacing="25" styleClass="content">
                <padding>
                    <Insets top="25" right="30" bottom="25" left="30"/>
                </padding>
                
                <Label text="🥤 Productos y Combos:" styleClass="section-title">
                    <font>
                        <Font name="Segoe UI Bold" size="20"/>
                    </font>
                </Label>
                
                <TilePane fx:id="productosTilePane" 
                          prefColumns="4" 
                          hgap="25" 
                          vgap="25"
                          styleClass="tile-pane">
                </TilePane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="15" styleClass="footer">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <HBox spacing="20" alignment="CENTER">
                <Label fx:id="productosSeleccionadosLabel" text="Ningún producto seleccionado" styleClass="resumen-label"/>
                <Label fx:id="totalLabel" text="Total confitería: $0.00" styleClass="resumen-total"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="button-secondary"/>
                <Button fx:id="btnSaltar" text="Saltar confitería" onAction="#onSaltar" styleClass="button-secondary"/>
                <Button fx:id="btnContinuar" text="Continuar" onAction="#onContinuar" styleClass="button-primary"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
