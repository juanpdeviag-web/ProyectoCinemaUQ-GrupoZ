<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.LoginController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, login-page">
 <top><VBox styleClass="app-header" spacing="6">
  <Label text="CinemaUQ · Iniciar sesión" styleClass="app-title" wrapText="true"/>
  <Label text="Elige tu perfil e ingresa tu contraseña para continuar." styleClass="app-subtitle" wrapText="true"/>
  <Button fx:id="btnVolver" text="Volver a cartelera" onAction="#onVolver" styleClass="logout-button"/>
 </VBox></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox alignment="TOP_CENTER" styleClass="content-container" spacing="14">
  <VBox maxWidth="820" spacing="14" alignment="TOP_CENTER">
   <Label text="Selecciona tu usuario" styleClass="section-title"/>
   <TilePane fx:id="usuariosTilePane" prefColumns="3" hgap="12" vgap="12" prefTileWidth="250" prefTileHeight="184" alignment="TOP_CENTER" tileAlignment="TOP_LEFT"/>
   <VBox styleClass="form-container" maxWidth="540" spacing="12">
    <Label text="Accede a tu cuenta" styleClass="section-title"/>
    <Label fx:id="usuarioSeleccionadoLabel" text="Selecciona un usuario arriba." styleClass="form-label" wrapText="true"/>
    <Label text="Contraseña" labelFor="$contrasenaField" styleClass="form-label"/>
    <PasswordField fx:id="contrasenaField" promptText="Tu contraseña" onAction="#onIniciarSesion" styleClass="form-field"/>
    <Label fx:id="infoLabel" text="Selecciona un usuario para continuar." wrapText="true" styleClass="mensaje-info"/>
    <Button fx:id="btnIniciarSesion" text="Iniciar sesión" onAction="#onIniciarSesion" styleClass="boton-principal" maxWidth="Infinity"/>
    <Separator/>
    <Label text="¿Es tu primera visita?" styleClass="form-label"/>
    <Button fx:id="btnCrearUsuario" text="Crear una cuenta" onAction="#onCrearUsuario" styleClass="boton-secundario"/>
   </VBox>
   <TitledPane text="Ver credenciales de demostración" expanded="false" maxWidth="540" styleClass="demo-panel">
    <VBox spacing="12">
     <Label text="Solo para probar la aplicación. Selecciona arriba el usuario correspondiente." wrapText="true" styleClass="helper-text"/>
     <VBox fx:id="contrasenasContainer" spacing="8"/>
    </VBox>
   </TitledPane>
  </VBox>
 </VBox></ScrollPane></center>

</BorderPane>
