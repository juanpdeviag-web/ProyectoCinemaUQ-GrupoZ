<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.TarjetaVirtualController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Tu tarjeta virtual" subtitulo="Consulta tu saldo, recarga y revisa tus movimientos." activa="tarjeta_virtual"/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<FlowPane hgap="20" vgap="20" alignment="CENTER" maxWidth="1000">
<VBox fx:id="tarjetaCard" spacing="12" styleClass="card" maxWidth="460" prefWidth="460">
 <Label text="Saldo disponible" styleClass="stat-label"/>
 <Label fx:id="saldoLabel" text="0" styleClass="checkout-total"/>
 <Label fx:id="estadoLabel" text="Estado de tarjeta pendiente" styleClass="estado-activo"/>
 <Label fx:id="codigoTarjetaLabel" text="Tarjeta pendiente" wrapText="true"/>
 <Label fx:id="nombreUsuarioLabel" wrapText="true"/>
 <Label fx:id="descuentosLabel" wrapText="true" styleClass="helper-text"/>
</VBox>
<VBox spacing="12" styleClass="form-card" maxWidth="460" prefWidth="460">
 <Label text="Recargar saldo" styleClass="section-title"/>
 <Label text="Monto de recarga (COP)" labelFor="$recargaTextField" styleClass="form-label"/>
 <TextField fx:id="recargaTextField" promptText="Escribe el monto" styleClass="form-field" maxWidth="440"/>
 <Button fx:id="btnRecargar" text="Recargar tarjeta" onAction="#onRecargar" styleClass="boton-secundario"/>
 <Label fx:id="mensajeRecargaLabel" visible="false" managed="false" wrapText="true"/>
</VBox>
<VBox spacing="12" styleClass="card" maxWidth="460" prefWidth="460">
 <Label text="Compra pendiente" styleClass="section-title"/>
 <Label fx:id="totalAPagarLabel" text="No hay compra pendiente" styleClass="stat-value" wrapText="true"/>
 <Label fx:id="puntosPagoLabel" wrapText="true" styleClass="helper-text"/>
 <Label text="Al pagar se confirmará la redención y ganarás 1 punto por cada $100 COP cobrados a tu tarjeta." wrapText="true" styleClass="helper-text"/>
 <Label fx:id="mensajeLabel" visible="false" wrapText="true" styleClass="mensaje-error"/>
 <Button fx:id="btnPagar" text="Pagar compra" onAction="#onPagar" styleClass="boton-principal"/>
</VBox>
<VBox spacing="12" styleClass="card" maxWidth="460" prefWidth="460">
 <Label text="Movimientos de tu tarjeta" styleClass="section-title"/>
 <Button fx:id="btnHistorial" text="Mostrar / ocultar movimientos" onAction="#onHistorial" styleClass="boton-secundario"/>
 <ListView fx:id="historialListView" prefHeight="220"/>
</VBox>
</FlowPane>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="boton-secundario"/>
 </FlowPane></bottom>
</BorderPane>
