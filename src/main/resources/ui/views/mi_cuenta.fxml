<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.MiCuentaController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Mi cuenta" subtitulo="Tus datos y accesos principales, sin menús ocultos." activa="mi_cuenta"/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<FlowPane hgap="20" vgap="20" alignment="CENTER" maxWidth="1000">
<VBox spacing="16" styleClass="card" maxWidth="460" prefWidth="460">
 <Label text="Datos personales" styleClass="section-title"/>
 <Label text="ID de usuario" styleClass="form-label"/><Label fx:id="idLabel" text="—"/>
 <Label text="Nombre" styleClass="form-label"/><Label fx:id="nombreLabel" text="—" wrapText="true"/>
 <Label text="Correo electrónico" styleClass="form-label"/><Label fx:id="emailLabel" text="—" wrapText="true"/>
 <Label text="Tipo de cuenta" styleClass="form-label"/><Label fx:id="rolLabel" text="—"/>
</VBox>
<VBox fx:id="saldoContainer" spacing="16" maxWidth="460" prefWidth="460" visible="false" managed="false">
 <VBox spacing="8" styleClass="card">
  <Label text="Saldo de tu tarjeta" styleClass="form-label"/><Label fx:id="saldoLabel" text="—" styleClass="stat-value"/>
 </VBox>
 <Label text="¿Qué quieres consultar?" styleClass="section-title"/>
 <FlowPane alignment="CENTER" hgap="16" vgap="16">
  <Button fx:id="btnMisPuntos" text="Mis puntos" onAction="#onMisPuntos" styleClass="account-link, boton-principal"/>
  <Button text="Tarjeta virtual" onAction="#onTarjetaVirtual" styleClass="account-link, boton-secundario"/>
  <Button text="Mis tickets" onAction="#onMisTickets" styleClass="account-link, boton-secundario"/>
 </FlowPane>
</VBox>
</FlowPane>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver a cartelera" onAction="#onVolver" styleClass="boton-secundario"/>
 </FlowPane></bottom>
</BorderPane>
