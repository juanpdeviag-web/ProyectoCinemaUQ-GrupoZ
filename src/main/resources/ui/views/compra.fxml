<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.CompraController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Revisa tu compra" subtitulo="Comprueba entradas, confitería y promociones antes de continuar." activa=""/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<FlowPane hgap="20" vgap="20" alignment="CENTER" maxWidth="1000">
<VBox fx:id="resumenContainer" spacing="10" styleClass="card" maxWidth="460" prefWidth="460">
 <Label text="Entradas" styleClass="section-title"/>
 <Label fx:id="peliculaLabel" text="Película pendiente" styleClass="card-title" wrapText="true"/>
 <Label fx:id="funcionLabel" text="Función pendiente" wrapText="true"/>
 <Label fx:id="asientosLabel" text="Sin asientos seleccionados" wrapText="true"/>
 <Separator/>
 <Label text="Productos" styleClass="form-label"/>
 <Label fx:id="productosLabel" text="Ninguno" wrapText="true"/>
 <Label text="Combos" styleClass="form-label"/>
 <Label fx:id="combosLabel" text="Ninguno" wrapText="true"/>
</VBox>
<VBox spacing="12" styleClass="card" maxWidth="460" prefWidth="460">
 <Label text="Promociones disponibles" styleClass="section-title"/>
 <CheckBox fx:id="chkDescuentoFijo" text="Descuento fijo de $5,000 COP" wrapText="true"/>
 <CheckBox fx:id="chkPromocion" text="Promoción estudiante (10%)" wrapText="true"/>
</VBox>
</FlowPane>
<VBox spacing="12" styleClass="card, purchase-points" maxWidth="940">
 <Label text="Mis puntos" styleClass="section-title"/>
 <Label fx:id="disponiblesPuntosLabel" text="Disponibles: 0 puntos" styleClass="form-label"/>
 <Label fx:id="equivalenciaPuntosLabel" wrapText="true"/>
 <Label text="100 puntos = $5 COP" styleClass="puntos-regla"/>
 <Label text="Cantidad de puntos a utilizar" labelFor="$puntosField" styleClass="form-label"/>
 <TextField fx:id="puntosField" promptText="Por ejemplo, 500" maxWidth="440" styleClass="form-field" onAction="#onAplicarPuntos"/>
 <Label fx:id="mensajeLabel" visible="false" managed="false" wrapText="true"/>
 <Label fx:id="redencionPreparadaLabel" text="Los puntos se consumen únicamente al confirmar un pago exitoso." wrapText="true" styleClass="mensaje-info"/>
 <FlowPane hgap="12" vgap="8">
  <Button fx:id="btnAplicarPuntos" text="Aplicar puntos" onAction="#onAplicarPuntos" styleClass="boton-principal"/>
  <Button fx:id="btnQuitarPuntos" text="Quitar puntos" onAction="#onQuitarPuntos" styleClass="boton-secundario" visible="false" managed="false"/>
 </FlowPane>
</VBox>
<VBox spacing="12" styleClass="card" maxWidth="940">
 <Label text="Resumen de importes" styleClass="section-title"/>
 <Label text="Subtotal" styleClass="form-label"/><Label fx:id="subtotalLabel" text="0"/>
 <Label text="Promociones y descuentos" styleClass="form-label"/><Label fx:id="descuentoLabel" text="0"/>
 <Label text="Descuento por puntos" styleClass="form-label"/><Label fx:id="descuentoPuntosLabel" text="0"/>
 <Separator/><Label text="Total a pagar" styleClass="form-label"/>
 <Label fx:id="totalLabel" text="0" styleClass="checkout-total" wrapText="true"/>
 <Label text="Confirma el importe final en la pantalla de pago." styleClass="helper-text" wrapText="true"/>
</VBox>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver a confitería" onAction="#onVolver" styleClass="boton-secundario"/>
<Button fx:id="btnConfirmar" text="Continuar al pago" onAction="#onConfirmar" styleClass="boton-principal" disable="true"/>
 </FlowPane></bottom>
</BorderPane>
