<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.FuncionesController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Elige tu función" subtitulo="1. Función  ·  2. Asientos  ·  3. Confitería  ·  4. Pago" activa=""/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<VBox spacing="8" maxWidth="1000">
 <Label fx:id="peliculaTituloLabel" text="Selecciona una película" styleClass="section-title" wrapText="true"/>
 <Label fx:id="peliculaInfoLabel" styleClass="helper-text" wrapText="true"/>
</VBox>
<FlowPane fx:id="funcionesContainer" hgap="16" vgap="16" maxWidth="1000" alignment="CENTER"/>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver a cartelera" onAction="#onVolver" styleClass="boton-secundario"/>
 </FlowPane></bottom>
</BorderPane>
