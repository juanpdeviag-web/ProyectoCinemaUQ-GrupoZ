<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.MisTicketsController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Mis tickets" subtitulo="Consulta tus reservas y sus acciones disponibles." activa="mis_tickets"/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<Label text="Tus compras" styleClass="section-title"/>
<Label fx:id="sinTicketsLabel" text="No tienes tickets comprados todavía. Explora la cartelera para elegir tu próxima película." wrapText="true" styleClass="empty-state"/>
<VBox fx:id="ticketsContainer" spacing="16" maxWidth="1000"/>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<Button fx:id="btnVolver" text="Volver a cartelera" onAction="#onVolver" styleClass="boton-secundario"/>
 </FlowPane></bottom>
</BorderPane>
