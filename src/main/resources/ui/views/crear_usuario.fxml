<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.CrearUsuarioController"
 stylesheets="@../styles/estilos.css" styleClass="root-app">
 <top><VBox styleClass="app-header" spacing="6">
  <Label text="Crear una cuenta" styleClass="app-title"/>
  <Label text="Registra un cliente o administrador. Completa los datos para comenzar." styleClass="app-subtitle" wrapText="true"/>
 </VBox></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER" spacing="20">
  <VBox styleClass="form-container" spacing="12" maxWidth="640">
   <Label text="Datos personales" styleClass="section-title"/>
   <Label text="ID de usuario" labelFor="$idTextField" styleClass="form-label"/>
   <TextField fx:id="idTextField" promptText="Identificador único, por ejemplo CLI006" styleClass="form-field"/>
   <Label text="Nombre completo" labelFor="$nombreTextField" styleClass="form-label"/>
   <TextField fx:id="nombreTextField" promptText="Nombre y apellido" styleClass="form-field"/>
   <Label text="Correo electrónico" labelFor="$emailTextField" styleClass="form-label"/>
   <TextField fx:id="emailTextField" promptText="nombre@correo.com" styleClass="form-field"/>
   <Separator/>
   <Label text="Acceso a tu cuenta" styleClass="section-title"/>
   <Label text="Contraseña" labelFor="$contrasenaField" styleClass="form-label"/>
   <PasswordField fx:id="contrasenaField" promptText="Escribe tu contraseña" styleClass="form-field"/>
   <Label text="Confirmar contraseña" labelFor="$confirmarContrasenaField" styleClass="form-label"/>
   <PasswordField fx:id="confirmarContrasenaField" promptText="Repite tu contraseña" styleClass="form-field"/>
   <Separator/>
   <Label text="Tipo de cuenta" styleClass="section-title"/>
   <Label text="Rol" labelFor="$rolComboBox" styleClass="form-label"/>
   <ComboBox fx:id="rolComboBox" promptText="Selecciona un rol" maxWidth="Infinity" styleClass="form-field"/>
   <Label text="Saldo inicial (COP) · opcional para clientes" labelFor="$saldoInicialTextField" styleClass="form-label" wrapText="true"/>
   <TextField fx:id="saldoInicialTextField" promptText="Saldo inicial para clientes" disable="true" styleClass="form-field"/>
   <Label fx:id="infoLabel" text="Completa los datos anteriores para crear la cuenta." styleClass="mensaje-info" wrapText="true"/>
   <Button fx:id="btnCrear" text="Crear cuenta" onAction="#onCrear" styleClass="boton-principal" maxWidth="Infinity"/>
  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" hgap="12" vgap="8">
  <Button fx:id="btnVolver" text="Volver a iniciar sesión" onAction="#onVolver" styleClass="boton-texto"/>
 </FlowPane></bottom>
</BorderPane>
