<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
 fx:controller="co.edu.uq.cinemauq.ui.controllers.AsientosController"
 stylesheets="@../styles/estilos.css" styleClass="root-app, uniform-page">
 <top><EncabezadoCinema titulo="Elige tus asientos" subtitulo="Selecciona en el plano. Los asientos ocupados no pueden elegirse." activa=""/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox styleClass="content-container" alignment="TOP_CENTER">
  <VBox maxWidth="1300" spacing="20" alignment="TOP_CENTER" styleClass="app-container">
<VBox spacing="8" styleClass="card" maxWidth="1100">
 <Label fx:id="funcionInfoLabel" text="Selecciona una función para ver sus asientos." styleClass="section-title" wrapText="true"/>
 <Label fx:id="salaInfoLabel" wrapText="true"/>
</VBox>
<VBox spacing="16" styleClass="card" maxWidth="1100" alignment="TOP_CENTER">
 <Label text="PANTALLA DEL CINE" styleClass="cinema-screen" maxWidth="Infinity" alignment="CENTER"/>
 <FlowPane hgap="16" vgap="8" alignment="CENTER" styleClass="seat-legend">
  <Label text="□ Disponible"/><Label text="✓ Seleccionado"/><Label text="× Ocupado"/>
  <Label text="♿ Accesible: sin identificación en el plano actual" wrapText="true"/>
 </FlowPane>
 <StackPane fx:id="mapaAsientos" minWidth="0" minHeight="0">
  <Group><GridPane fx:id="asientosGrid" hgap="8" vgap="8" alignment="CENTER" styleClass="seat-grid"/></Group>
 </StackPane>
</VBox>

  </VBox>
 </VBox></ScrollPane></center>
 <bottom><FlowPane styleClass="app-footer" alignment="CENTER" hgap="12" vgap="8">
<VBox spacing="4" maxWidth="400"><Label fx:id="asientosSeleccionadosLabel" text="Ningún asiento seleccionado" wrapText="true"/><Label fx:id="cantidadLabel" text="Cantidad: 0"/><Label fx:id="totalLabel" text="Subtotal: COP 0" styleClass="stat-value"/></VBox>
<Button fx:id="btnVolver" text="Volver a funciones" onAction="#onVolver" styleClass="boton-secundario"/>
<Button fx:id="btnContinuar" text="Continuar" onAction="#onContinuar" styleClass="boton-principal" disable="true"/>
 </FlowPane></bottom>
</BorderPane>
