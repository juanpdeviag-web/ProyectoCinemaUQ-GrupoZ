<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import co.edu.uq.cinemauq.ui.controllers.EncabezadoCinema?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uq.cinemauq.ui.controllers.AdminPanelController" stylesheets="@../styles/estilos.css" styleClass="root-app,uniform-page">
 <top><EncabezadoCinema titulo="Administración CinemaUQ" subtitulo="Catálogo, operaciones y reportes sobre los datos reales del cine." activa="admin_panel"/></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox alignment="TOP_CENTER" styleClass="content-container" minWidth="0">
  <VBox fx:id="layout" maxWidth="1300" minWidth="0" spacing="18" styleClass="app-container">
   <FlowPane fx:id="navegacion" hgap="8" vgap="8" styleClass="admin-navigation"/>
   <HBox fx:id="distribucion" spacing="20" minWidth="0"><VBox fx:id="zonaTrabajo" spacing="18" minWidth="0" HBox.hgrow="ALWAYS">
   <Label fx:id="titulo" text="Administración" styleClass="app-title" wrapText="true"/>
   <FlowPane hgap="12" vgap="10" alignment="CENTER_LEFT">
    <VBox spacing="5"><Label text="Buscar en el área" styleClass="form-label"/><TextField fx:id="busqueda" promptText="Nombre, cliente o ID" prefWidth="240"/></VBox>
    <VBox spacing="5"><Label text="Desde" styleClass="form-label"/><DatePicker fx:id="desde" prefWidth="155"/></VBox>
    <VBox spacing="5"><Label text="Hasta" styleClass="form-label"/><DatePicker fx:id="hasta" prefWidth="155"/></VBox>
    <Button text="Actualizar" onAction="#actualizar" styleClass="boton-secundario"/>
   </FlowPane>
   <Label fx:id="mensaje" text="Selecciona un área. El historial financiero es de solo lectura." wrapText="true" styleClass="mensaje-info"/>
   <VBox fx:id="contenido" spacing="16" minWidth="0"/>
   </VBox></HBox>
  </VBox>
 </VBox></ScrollPane></center>
</BorderPane>